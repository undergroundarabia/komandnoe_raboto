<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/nlog-internal.log">

  <targets>
    <!-- Все события за день -->
    <target xsi:type="File" name="allFile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            encoding="utf-8"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />

    <!-- Только ошибки, отдельным файлом -->
    <target xsi:type="File" name="errorFile"
            fileName="${basedir}/logs/errors-${shortdate}.log"
            encoding="utf-8"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}${newline}${exception:format=tostring}${newline}" />
  </targets>

  <rules>
    <!-- Внутренние сообщения EF Core пишем только начиная с Warning -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Debug" writeTo="allFile" />
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>
</nlog>
